{
  "name": "csi-stateflow-studio",
  "version": "0.1.8",
  "description": "Studio visual independente para máquinas de estado CSI/P2K (.stateflow e .executionflow)",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "postinstall": "node node_modules/electron/install.js",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "test": "node --test tests/*.node.test.js",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test",
    "doc:record": "node scripts/record-doc-flows.js",
    "doc:gifs": "python scripts/compile-doc-gifs.py",
    "doc:site": "node scripts/record-doc-flows.js && python scripts/compile-doc-gifs.py && node scripts/generate-doc-site.js",
    "build:docs": "node scripts/generate-doc-site.js",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "stateflow",
    "executionflow",
    "p2k",
    "csi",
    "react-flow",
    "electron"
  ],
  "author": "Edney Siqueira",
  "license": "ISC",
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.0.8",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  }
}
