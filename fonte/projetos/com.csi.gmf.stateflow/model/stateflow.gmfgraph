<?xml version="1.0" encoding="UTF-8"?>
<gmfgraph:Canvas xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:gmfgraph="http://www.eclipse.org/gmf/2006/GraphicalDefinition" name="stateflow">
  <figures
      name="Default">
    <figures
        xsi:type="gmfgraph:PolylineDecoration"
        name="OpenArrow">
      <template
          x="-1"
          y="1"/>
      <template/>
      <template
          x="-1"
          y="-1"/>
    </figures>
    <descriptors
        name="FlowObjectConnectionFigure">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="FlowObjectConnectionFigure"
          targetDecoration="//@figures.0/@figures.0">
        <foregroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="blue"/>
        <children
            xsi:type="gmfgraph:Label"
            name="LabelExecutionFlowResultValueFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.0/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="EllipticalStateFigure">
      <actualFigure
          xsi:type="gmfgraph:Ellipse"
          name="EllipticalStateFigure">
        <backgroundColor
            xsi:type="gmfgraph:RGBColor"
            red="207"
            green="207"
            blue="207"/>
        <children
            xsi:type="gmfgraph:Label"
            name="StateIdFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.1/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="ExecutionFlowObjectFigure">
      <actualFigure
          xsi:type="gmfgraph:RoundedRectangle"
          name="ExecutionFlowObjectFigure">
        <backgroundColor
            xsi:type="gmfgraph:RGBColor"
            red="255"
            green="213"
            blue="191"/>
        <children
            xsi:type="gmfgraph:Label"
            name="ExecutionFlowObjectTitleFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.2/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="StateConnectionFigure">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="StateConnectionFigure"
          targetDecoration="//@figures.0/@figures.0">
        <foregroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="darkGreen"/>
        <children
            xsi:type="gmfgraph:Label"
            name="LabelEventIDFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.3/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="StartPointFigure">
      <actualFigure
          xsi:type="gmfgraph:Ellipse"
          name="StartPointFigure">
        <backgroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="black"/>
        <preferredSize
            dx="20"
            dy="15"/>
      </actualFigure>
    </descriptors>
    <descriptors
        name="StartPointConnectionFigure">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="StartPointConnectionFigure"
          lineKind="LINE_DOT"
          targetDecoration="//@figures.0/@figures.0">
        <backgroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="black"/>
      </actualFigure>
    </descriptors>
  </figures>
  <nodes
      name="ExecutionFlowObject"
      figure="ExecutionFlowObjectFigure"/>
  <nodes
      name="State"
      figure="EllipticalStateFigure"/>
  <nodes
      name="StartPoint"
      figure="StartPointFigure"/>
  <connections
      name="FlowObjectConnectionLink"
      figure="FlowObjectConnectionFigure"/>
  <connections
      name="StateConnectionLink"
      figure="StateConnectionFigure"/>
  <connections
      name="StartPointConnectionLink"
      figure="StartPointConnectionFigure"/>
  <labels
      name="ExecutionFlowObjectTitle"
      figure="ExecutionFlowObjectFigure"
      resizeConstraint="NORTH"
      accessor="//@figures.0/@descriptors.2/@accessors.0"/>
  <labels
      name="StateId"
      figure="EllipticalStateFigure"
      resizeConstraint="NORTH"
      accessor="//@figures.0/@descriptors.1/@accessors.0"/>
  <labels
      name="ExecutionFlowResultValue"
      figure="FlowObjectConnectionFigure"
      resizeConstraint="NORTH"
      elementIcon="false"
      accessor="//@figures.0/@descriptors.0/@accessors.0"/>
  <labels
      name="EventId"
      figure="StateConnectionFigure"
      resizeConstraint="NORTH"
      elementIcon="false"
      accessor="//@figures.0/@descriptors.3/@accessors.0"/>
</gmfgraph:Canvas>
