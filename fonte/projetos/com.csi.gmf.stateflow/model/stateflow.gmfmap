<?xml version="1.0" encoding="UTF-8"?>
<gmfmap:Mapping xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:gmfmap="http://www.eclipse.org/gmf/2008/mappings"
    xmlns:gmftool="http://www.eclipse.org/gmf/2005/ToolDefinition">
  <nodes>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/executionFlows"/>
    <ownedChild>
      <domainMetaElement
          href="stateflow.ecore#//ExecutionFlowObject"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="stateflow.gmfgraph#ExecutionFlowObjectTitle"/>
        <features
            href="stateflow.ecore#//ExecutionFlowObject/title"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="stateflow.gmftool#//@palette/@tools.0/@tools.1"/>
      <diagramNode
          href="stateflow.gmfgraph#ExecutionFlowObject"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/states"/>
    <ownedChild>
      <domainMetaElement
          href="stateflow.ecore#//State"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping"
          viewPattern="">
        <diagramLabel
            href="stateflow.gmfgraph#StateId"/>
        <features
            href="stateflow.ecore#//State/id"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="stateflow.gmftool#//@palette/@tools.0/@tools.2"/>
      <diagramNode
          href="stateflow.gmfgraph#State"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/startPoint"/>
    <ownedChild>
      <domainMetaElement
          href="stateflow.ecore#//StartPoint"/>
      <tool
          xsi:type="gmftool:CreationTool"
          href="stateflow.gmftool#//@palette/@tools.0/@tools.0"/>
      <diagramNode
          href="stateflow.gmfgraph#StartPoint"/>
    </ownedChild>
  </nodes>
  <links>
    <domainMetaElement
        href="stateflow.ecore#//FlowObjectConnection"/>
    <labelMappings
        xsi:type="gmfmap:FeatureLabelMapping"
        viewPattern="">
      <diagramLabel
          href="stateflow.gmfgraph#ExecutionFlowResultValue"/>
      <features
          href="stateflow.ecore#//FlowObjectConnection/executionFlowResultValue"/>
    </labelMappings>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/flowConnections"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="stateflow.gmftool#//@palette/@tools.1/@tools.0"/>
    <diagramLink
        href="stateflow.gmfgraph#FlowObjectConnectionLink"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//FlowObjectConnection/sourceFlow"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//FlowObjectConnection/destinationState"/>
  </links>
  <links>
    <domainMetaElement
        href="stateflow.ecore#//EventConnection"/>
    <labelMappings
        xsi:type="gmfmap:FeatureLabelMapping"
        viewPattern="">
      <diagramLabel
          href="stateflow.gmfgraph#EventId"/>
      <features
          href="stateflow.ecore#//EventConnection/eventID"/>
    </labelMappings>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/stateConnections"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="stateflow.gmftool#//@palette/@tools.1/@tools.1"/>
    <diagramLink
        href="stateflow.gmfgraph#StateConnectionLink"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//EventConnection/sourceState"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//EventConnection/destinationFlow"/>
  </links>
  <links>
    <domainMetaElement
        href="stateflow.ecore#//StartPointConnection"/>
    <containmentFeature
        href="stateflow.ecore#//StateFlow/startPointConnection"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="stateflow.gmftool#//@palette/@tools.1/@tools.2"/>
    <diagramLink
        href="stateflow.gmfgraph#StartPointConnectionLink"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//StartPointConnection/startPoint"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="stateflow.ecore#//StartPointConnection/destinationState"/>
  </links>
  <diagram>
    <diagramCanvas
        href="stateflow.gmfgraph#stateflow"/>
    <domainModel
        href="stateflow.ecore#/"/>
    <domainMetaElement
        href="stateflow.ecore#//StateFlow"/>
    <palette
        href="stateflow.gmftool#//@palette"/>
  </diagram>
</gmfmap:Mapping>
