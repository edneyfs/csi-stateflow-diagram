<?xml version="1.0" encoding="UTF-8"?>
<gmfgraph:Canvas xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:gmfgraph="http://www.eclipse.org/gmf/2006/GraphicalDefinition" name="executionflow">
  <figures
      name="Default">
    <figures
        xsi:type="gmfgraph:PolylineDecoration"
        name="OpenArrow">
      <template
          x="-1"
          y="1"/>
      <template/>
      <template
          x="-1"
          y="-1"/>
    </figures>
    <descriptors
        name="StartPointFigure">
      <actualFigure
          xsi:type="gmfgraph:Ellipse"
          name="StartPointFigure">
        <layoutData
            xsi:type="gmfgraph:BorderLayoutData"/>
        <backgroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="black"/>
        <location/>
        <size
            x="30"
            y="30"/>
      </actualFigure>
    </descriptors>
    <descriptors
        name="StartPointConnectionFigure">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="StartPointConnectionFigure"
          lineKind="LINE_DASH"
          targetDecoration="//@figures.0/@figures.0">
        <foregroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="black"/>
        <backgroundColor
            xsi:type="gmfgraph:ConstantColor"
            value="black"/>
      </actualFigure>
    </descriptors>
    <descriptors
        name="RoundedExecutableFlowObjectFigure">
      <actualFigure
          xsi:type="gmfgraph:RoundedRectangle"
          name="RoundedExecutableFlowObjectFigure">
        <backgroundColor
            xsi:type="gmfgraph:RGBColor"
            red="207"
            green="220"
            blue="239"/>
        <children
            xsi:type="gmfgraph:Label"
            name="ExecutableFlowObjectClassNameFigure"
            text=""/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.2/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="RoundedExecutionFlowObjectFigure">
      <actualFigure
          xsi:type="gmfgraph:RoundedRectangle"
          name="RoundedExecutionFlowObjectFigure">
        <backgroundColor
            xsi:type="gmfgraph:RGBColor"
            red="255"
            green="255"
            blue="202"/>
        <children
            xsi:type="gmfgraph:Label"
            name="ExecutionFlowObjectFileNameFigure"
            text=""/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.3/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="EllipticalExecutionFlowResultFigure">
      <actualFigure
          xsi:type="gmfgraph:Ellipse"
          name="EllipticalExecutionFlowResultFigure">
        <backgroundColor
            xsi:type="gmfgraph:RGBColor"
            red="206"
            green="255"
            blue="206"/>
        <children
            xsi:type="gmfgraph:Label"
            name="ExecutionFlowResultExecutionFlowResultValueFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.4/@actualFigure/@children.0"/>
    </descriptors>
    <descriptors
        name="FlowObjectConnectionFigure">
      <actualFigure
          xsi:type="gmfgraph:PolylineConnection"
          name="FlowObjectConnectionFigure"
          targetDecoration="//@figures.0/@figures.0">
        <children
            xsi:type="gmfgraph:Label"
            name="ExecutionResultValueFigure"
            text="&lt;...>"/>
      </actualFigure>
      <accessors
          figure="//@figures.0/@descriptors.5/@actualFigure/@children.0"/>
    </descriptors>
  </figures>
  <nodes
      name="StartPoint"
      figure="StartPointFigure"
      affixedParentSide="NORTH">
    <facets
        xsi:type="gmfgraph:AlignmentFacet"/>
  </nodes>
  <nodes
      name="ExecutableFlowObject"
      figure="RoundedExecutableFlowObjectFigure"/>
  <nodes
      name="ExecutionFlowObject"
      figure="RoundedExecutionFlowObjectFigure"/>
  <nodes
      name="ExecutionFlowResult"
      figure="EllipticalExecutionFlowResultFigure"/>
  <connections
      name="StartPointConnectionLink"
      figure="StartPointConnectionFigure"/>
  <connections
      name="FlowObjectConnectionLink"
      figure="FlowObjectConnectionFigure"/>
  <labels
      name="ExecutableFlowObjectClassName"
      figure="RoundedExecutableFlowObjectFigure"
      accessor="//@figures.0/@descriptors.2/@accessors.0"/>
  <labels
      name="ExecutionFlowObjectFileName"
      figure="RoundedExecutionFlowObjectFigure"
      accessor="//@figures.0/@descriptors.3/@accessors.0"/>
  <labels
      name="ExecutionFlowResultExecutionFlowResultValue"
      figure="EllipticalExecutionFlowResultFigure"
      affixedParentSide="SOUTH"
      accessor="//@figures.0/@descriptors.4/@accessors.0"/>
  <labels
      name="ExecutionResultValue"
      figure="FlowObjectConnectionFigure"
      accessor="//@figures.0/@descriptors.5/@accessors.0"/>
</gmfgraph:Canvas>
