<?xml version="1.0" encoding="UTF-8"?>
<gmfmap:Mapping xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:gmfmap="http://www.eclipse.org/gmf/2008/mappings"
    xmlns:gmftool="http://www.eclipse.org/gmf/2005/ToolDefinition">
  <nodes>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/executionFlowObjects"/>
    <ownedChild>
      <domainMetaElement
          href="executionflow.ecore#//ExecutionFlowObject"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping">
        <diagramLabel
            href="executionflow.gmfgraph#ExecutionFlowObjectFileName"/>
        <features
            href="executionflow.ecore#//ExecutionFlowObject/fileName"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="executionflow.gmftool#//@palette/@tools.0/@tools.2"/>
      <diagramNode
          href="executionflow.gmfgraph#ExecutionFlowObject"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/executableFlowObjects"/>
    <ownedChild>
      <domainMetaElement
          href="executionflow.ecore#//ExecutableFlowObject"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping"
          readOnly="true"
          viewPattern="">
        <diagramLabel
            href="executionflow.gmfgraph#ExecutableFlowObjectClassName"/>
        <features
            href="executionflow.ecore#//ExecutableFlowObject/simpleClassName"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="executionflow.gmftool#//@palette/@tools.0/@tools.1"/>
      <diagramNode
          href="executionflow.gmfgraph#ExecutableFlowObject"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/results"/>
    <ownedChild>
      <domainMetaElement
          href="executionflow.ecore#//ExecutionFlowResult"/>
      <labelMappings
          xsi:type="gmfmap:FeatureLabelMapping"
          viewPattern="">
        <diagramLabel
            href="executionflow.gmfgraph#ExecutionFlowResultExecutionFlowResultValue"/>
        <features
            href="executionflow.ecore#//ExecutionFlowResult/executionFlowResultValue"/>
      </labelMappings>
      <tool
          xsi:type="gmftool:CreationTool"
          href="executionflow.gmftool#//@palette/@tools.0/@tools.3"/>
      <diagramNode
          href="executionflow.gmfgraph#ExecutionFlowResult"/>
    </ownedChild>
  </nodes>
  <nodes>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/startPoint"/>
    <ownedChild>
      <domainMetaElement
          href="executionflow.ecore#//StartPoint"/>
      <tool
          xsi:type="gmftool:CreationTool"
          href="executionflow.gmftool#//@palette/@tools.0/@tools.0"/>
      <diagramNode
          href="executionflow.gmfgraph#StartPoint"/>
    </ownedChild>
  </nodes>
  <links>
    <domainMetaElement
        href="executionflow.ecore#//FlowObjectConnection"/>
    <labelMappings
        xsi:type="gmfmap:FeatureLabelMapping"
        viewPattern="">
      <diagramLabel
          href="executionflow.gmfgraph#ExecutionResultValue"/>
      <features
          href="executionflow.ecore#//FlowObjectConnection/executionFlowResultValue"/>
    </labelMappings>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/flowConnections"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="executionflow.gmftool#//@palette/@tools.1/@tools.0"/>
    <diagramLink
        href="executionflow.gmfgraph#FlowObjectConnectionLink"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="executionflow.ecore#//FlowObjectConnection/sourceObject"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="executionflow.ecore#//FlowObjectConnection/destinationObject"/>
  </links>
  <links>
    <domainMetaElement
        href="executionflow.ecore#//StartPointConnection"/>
    <containmentFeature
        href="executionflow.ecore#//ExecutionFlow/startPointConnection"/>
    <tool
        xsi:type="gmftool:CreationTool"
        href="executionflow.gmftool#//@palette/@tools.1/@tools.1"/>
    <diagramLink
        href="executionflow.gmfgraph#StartPointConnectionLink"/>
    <sourceMetaFeature
        xsi:type="ecore:EReference"
        href="executionflow.ecore#//StartPointConnection/startPoint"/>
    <linkMetaFeature
        xsi:type="ecore:EReference"
        href="executionflow.ecore#//StartPointConnection/destinationObject"/>
  </links>
  <diagram>
    <diagramCanvas
        href="executionflow.gmfgraph#executionflow"/>
    <domainModel
        href="executionflow.ecore#/"/>
    <domainMetaElement
        href="executionflow.ecore#//ExecutionFlow"/>
    <palette
        href="executionflow.gmftool#//@palette"/>
  </diagram>
  <audits
      id="AuditContainer"
      name="Audits"
      description="Validacoes">
    <audits
        name="batchClassNameRule"
        description="Batch verification for classname"
        id="batchClassNameCheck"
        message="Nome de classe inválido ou indefinido!">
      <rule
          body="batchCheckClassName"
          language="java"/>
      <target
          xsi:type="gmfmap:DomainElementTarget">
        <element
            href="executionflow.ecore#//ExecutableFlowObject"/>
      </target>
    </audits>
    <audits
        name="batchResultValueRule"
        description="Batch verification for ResultValue"
        id="batchResultValueCheck"
        message="Resultado do objeto origem inválido ou não informado!">
      <rule
          body="batchCheckResultValue"
          language="java"/>
      <target
          xsi:type="gmfmap:DomainElementTarget">
        <element
            href="executionflow.ecore#//FlowObjectConnection"/>
      </target>
    </audits>
    <audits
        name="batchExecutionFlowResultRule"
        description="Batch verification for ExecutionFlow Result"
        id="batchCheckExecutionFlowResult"
        message="O valor do resultado deve ser informado!">
      <rule
          body="batchCheckExecutionFlowResult"
          language="java"/>
      <target
          xsi:type="gmfmap:DomainElementTarget">
        <element
            href="executionflow.ecore#//ExecutionFlowResult"/>
      </target>
    </audits>
    <audits
        name="batchFileNameRule"
        description="Batch verification for filename"
        id="batchCheckFileName"
        message="Nome de arquivo inválido ou indefinido!">
      <rule
          body="batchCheckFileName"
          language="java"/>
      <target
          xsi:type="gmfmap:DomainElementTarget">
        <element
            href="executionflow.ecore#//ExecutionFlowObject"/>
      </target>
    </audits>
    <audits
        name="batchCheckUsedResultsRule"
        description="Check for unused results"
        id="batchCheckUsedResults"
        severity="WARNING"
        message="Todos os resultados devem estar conectados!">
      <rule
          body="batchCheckUsedResults"
          language="java"/>
      <target
          xsi:type="gmfmap:DomainElementTarget">
        <element
            href="executionflow.ecore#//ExecutableFlowObject"/>
      </target>
    </audits>
  </audits>
</gmfmap:Mapping>
