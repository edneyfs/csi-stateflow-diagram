<extension point="org.eclipse.emf.validation.constraintProviders">
	<category
		id="AuditContainer"
		mandatory="false"
		name="Audits">
	<![CDATA[Validacoes]]>
	</category>		
	<constraintProvider cache="true">
		<package namespaceUri="http:///com/csi/gmf/executionflow.ecore"/>
		<constraints categories="AuditContainer">		
			<constraint id="batchClassNameCheck"
				lang="Java" class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$Adapter1"
				name="batchClassNameRule" mode="Batch"
				severity="ERROR" statusCode="200">			
	            <description><![CDATA[Batch verification for classname]]></description>
	            <message><![CDATA[Nome de classe inválido ou indefinido!]]></message>
				<target class="executionflow.ExecutableFlowObject"/>
			</constraint>
			<constraint id="batchResultValueCheck"
				lang="Java" class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$Adapter2"
				name="batchResultValueRule" mode="Batch"
				severity="ERROR" statusCode="201">			
	            <description><![CDATA[Batch verification for ResultValue]]></description>
	            <message><![CDATA[Resultado do objeto origem inválido ou não informado!]]></message>
				<target class="executionflow.FlowObjectConnection"/>
			</constraint>
			<constraint id="batchCheckExecutionFlowResult"
				lang="Java" class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$Adapter3"
				name="batchExecutionFlowResultRule" mode="Batch"
				severity="ERROR" statusCode="202">			
	            <description><![CDATA[Batch verification for ExecutionFlow Result]]></description>
	            <message><![CDATA[O valor do resultado deve ser informado!]]></message>
				<target class="executionflow.ExecutionFlowResult"/>
			</constraint>
			<constraint id="batchCheckFileName"
				lang="Java" class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$Adapter4"
				name="batchFileNameRule" mode="Batch"
				severity="ERROR" statusCode="203">			
	            <description><![CDATA[Batch verification for filename]]></description>
	            <message><![CDATA[Nome de arquivo inválido ou indefinido!]]></message>
				<target class="executionflow.ExecutionFlowObject"/>
			</constraint>
			<constraint id="batchCheckUsedResults"
				lang="Java" class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$Adapter5"
				name="batchCheckUsedResultsRule" mode="Batch"
				severity="WARNING" statusCode="204">			
	            <description><![CDATA[Check for unused results]]></description>
	            <message><![CDATA[Todos os resultados devem estar conectados!]]></message>
				<target class="executionflow.ExecutableFlowObject"/>
			</constraint>
		</constraints>
	</constraintProvider>
</extension>

<extension point="org.eclipse.emf.validation.constraintBindings">
	<clientContext default="false" id="com.csi.gmf.executionflow.diagram.DefaultCtx">
		<selector class="com.csi.gmf.executionflow.diagram.providers.ExecutionflowValidationProvider$DefaultCtx"/>
	</clientContext>
	<binding context="com.csi.gmf.executionflow.diagram.DefaultCtx">	
		<constraint ref="com.csi.gmf.executionflow.diagram.batchClassNameCheck"/>	
		<constraint ref="com.csi.gmf.executionflow.diagram.batchResultValueCheck"/>	
		<constraint ref="com.csi.gmf.executionflow.diagram.batchCheckExecutionFlowResult"/>	
		<constraint ref="com.csi.gmf.executionflow.diagram.batchCheckFileName"/>	
		<constraint ref="com.csi.gmf.executionflow.diagram.batchCheckUsedResults"/>
	</binding>		
