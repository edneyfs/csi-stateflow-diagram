    language="">
  <foreignModel>@model</foreignModel>
  <genPackages prefix="Stateflow" basePackage="com.csi.gmf" disposableProviderFactory="true"
      ecorePackage="stateflow.ecore#/">
    <genClasses ecoreClass="stateflow.ecore#//ExecutionFlowObject">
