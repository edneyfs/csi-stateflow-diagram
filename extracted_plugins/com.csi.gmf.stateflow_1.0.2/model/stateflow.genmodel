      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute stateflow.ecore#//StateFlow/description"/>
      <genFeatures createChild="false" propertyCategory="" ecoreFeature="ecore:EAttribute stateflow.ecore#//StateFlow/persistent"/>
    </genClasses>
    <genClasses ecoreClass="stateflow.ecore#//EventConnection">
