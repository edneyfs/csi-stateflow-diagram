package com.csi.gmf.stateflow.diagram.part;

import java.io.File;
import java.io.IOException;
import java.util.HashMap;
import java.util.Iterator;
import java.util.List;

import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.ParserConfigurationException;

import org.eclipse.emf.common.util.URI;
import org.eclipse.emf.ecore.EObject;
import org.eclipse.emf.ecore.EStructuralFeature;
import org.eclipse.emf.edit.ui.action.LoadResourceAction.LoadResourceDialog;
import org.eclipse.gmf.runtime.diagram.ui.actions.ActionIds;
import org.eclipse.gmf.runtime.diagram.ui.commands.ICommandProxy;
import org.eclipse.gmf.runtime.diagram.ui.parts.DiagramCommandStack;
import org.eclipse.gmf.runtime.diagram.ui.requests.ArrangeRequest;
import org.eclipse.gmf.runtime.emf.type.core.IElementType;
import org.eclipse.gmf.runtime.emf.type.core.commands.CreateElementCommand;
import org.eclipse.gmf.runtime.emf.type.core.commands.SetValueCommand;
import org.eclipse.gmf.runtime.emf.type.core.requests.CreateElementRequest;
import org.eclipse.gmf.runtime.emf.type.core.requests.CreateRelationshipRequest;
import org.eclipse.gmf.runtime.emf.type.core.requests.SetRequest;
import org.eclipse.gmf.runtime.notation.impl.DiagramImpl;
import org.eclipse.jface.action.IAction;
import org.eclipse.jface.dialogs.IDialogConstants;
import org.eclipse.jface.dialogs.MessageDialog;
import org.eclipse.jface.viewers.ISelection;
import org.eclipse.jface.viewers.IStructuredSelection;
import org.eclipse.swt.widgets.Shell;
import org.eclipse.ui.IObjectActionDelegate;
import org.eclipse.ui.IWorkbenchPart;
import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.NamedNodeMap;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.SAXException;

import com.csi.gmf.stateflow.EventConnection;
import com.csi.gmf.stateflow.FlowObject;
import com.csi.gmf.stateflow.FlowObjectConnection;
import com.csi.gmf.stateflow.StartPoint;
import com.csi.gmf.stateflow.StartPointConnection;
import com.csi.gmf.stateflow.State;
import com.csi.gmf.stateflow.StateflowPackage;
import com.csi.gmf.stateflow.diagram.edit.parts.StateFlowEditPart;
import com.csi.gmf.stateflow.diagram.providers.StateflowElementTypes;
import com.csi.gmf.stateflow.impl.ExecutionFlowObjectImpl;
import com.csi.gmf.stateflow.impl.StateImpl;

/**
 * @generated
 */
public class StateflowLoadResourceAction implements IObjectActionDelegate {

	/**
	 * @generated
	 */
	private StateFlowEditPart mySelectedElement;

	/**
	 * @generated
	 */
	private Shell myShell;

	/**
	 * @generated NOT
	 */
	private final String STATE_FILE_EXTENSION = "stateflow";

	/**
	 * @generated
	 */
	public void setActivePart(IAction action, IWorkbenchPart targetPart) {
		myShell = targetPart.getSite().getShell();
	}

	/**
	 * @throws ParserConfigurationException 
	 * @throws IOException 
	 * @throws SAXException 
	 * @generated NOT
	 */
	private void processFile(URI fileToProcess)
			throws ParserConfigurationException, SAXException, IOException {

		try {
			File file = new File(fileToProcess.toFileString());

			HashMap objectMap = new HashMap();
			HashMap stateMap = new HashMap();

			if (file.getName().endsWith(STATE_FILE_EXTENSION)) {
				DocumentBuilder docBuilder = DocumentBuilderFactory.newInstance()
						.newDocumentBuilder();

				// Parse do arquivo
				Document document = docBuilder.parse(file);

				// Recupera os nós do arquivo de estados
				NodeList list = document.getDocumentElement().getChildNodes();

				// Pilha de comandos a ser executada
				DiagramCommandStack stack = mySelectedElement
						.getDiagramEditDomain().getDiagramCommandStack();

				// Iteração nos nós do arquivo
				for (int i = 0; i < list.getLength(); i++) {
					Node node = list.item(i);

					// Verifica se é um nó de elemento válido
					if (node.getNodeType() == Node.ELEMENT_NODE) {

						Element element = (Element) node;

						NamedNodeMap map = element.getAttributes();

						// Verifica se o elemento tem atributos
						if (map != null) {
							if (node.getNodeName().equals("states")) {

								// Comando para criação do Objeto no diagrama
								CreateElementRequest createRequest = new CreateElementRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(),
										StateflowElementTypes.State_1002,
										StateflowPackage.eINSTANCE
												.getStateFlow_States());

								CreateElementCommand command = new CreateElementCommand(
										createRequest);

								ICommandProxy commandProxy = new ICommandProxy(
										command);

								stack.execute(commandProxy);

								StateImpl state = (StateImpl) command
										.getNewElement();

								// Armazena o objeto no map
								objectMap.put(element.getAttribute("pathKey"),
										state);

								stateMap.put(element.getAttribute("id"), state);

								fillAttribute(state, StateflowPackage.eINSTANCE
										.getFlowObject_PathKey(), new Long(element.getAttribute("pathKey")));
								
								fillAttribute(state, StateflowPackage.eINSTANCE
										.getState_Id(), element.getAttribute("id"));

								fillAttribute(state, StateflowPackage.eINSTANCE
										.getState_Description(), element.getAttribute("description"));

							} else if (node.getNodeName().equals("executionFlows")) {

								// Comando para criação do Objeto no diagrama
								CreateElementRequest createRequest = new CreateElementRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(),
										StateflowElementTypes.ExecutionFlowObject_1001,
										StateflowPackage.eINSTANCE
												.getStateFlow_ExecutionFlows());

								CreateElementCommand command = new CreateElementCommand(
										createRequest);

								ICommandProxy commandProxy = new ICommandProxy(
										command);

								stack.execute(commandProxy);

								ExecutionFlowObjectImpl flow = (ExecutionFlowObjectImpl) command
										.getNewElement();

								// Armazena o objeto no map
								objectMap.put(element.getAttribute("pathKey"), flow);
								
								fillAttribute(flow, StateflowPackage.eINSTANCE
										.getFlowObject_PathKey(), new Long(element
										.getAttribute("pathKey")));

								fillAttribute(flow, StateflowPackage.eINSTANCE
										.getExecutionFlowObject_FilePath(), element
										.getAttribute("filePath"));

								fillAttribute(flow, StateflowPackage.eINSTANCE
										.getExecutionFlowObject_Title(), element
										.getAttribute("title"));

								fillAttribute(flow, StateflowPackage.eINSTANCE
										.getExecutionFlowObject_Id(), element
										.getAttribute("id"));

								fillAttribute(flow, StateflowPackage.eINSTANCE
										.getExecutionFlowObject_Description(), element
										.getAttribute("description"));
								
							} else if (node.getNodeName().equals(
									"startPointConnection")) {

								// Comando para criação do StartPoint no diagrama
								CreateElementRequest createRequest = new CreateElementRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(),
										StateflowElementTypes.StartPoint_1003);

								CreateElementCommand startCommand = new CreateElementCommand(
										createRequest);

								ICommandProxy commandProxyStart = new ICommandProxy(
										startCommand);

								stack.execute(commandProxyStart);

								StartPoint sourceObject = (StartPoint) startCommand
										.getNewElement();

								FlowObject targetObject = (FlowObject) stateMap
										.get(element
												.getAttribute("destinationStateId"));

								IElementType eType = StateflowElementTypes.StartPointConnection_3003;

								CreateRelationshipRequest req = new CreateRelationshipRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(), sourceObject,
										targetObject, eType);

								CreateElementCommand connectionCommand = new CreateElementCommand(
										req);

								ICommandProxy commandProxyConnection = new ICommandProxy(
										connectionCommand);

								stack.execute(commandProxyConnection);

								StartPointConnection connection = (StartPointConnection) connectionCommand
										.getNewElement();

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getStartPointConnection_StartPoint(),
										sourceObject);

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getStartPointConnection_DestinationState(),
										targetObject);

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getStartPointConnection_DestinationStateId(),
										((State) targetObject).getId());

							} else if (node.getNodeName()
									.equals("stateConnections")) {

								State sourceObject = (State) objectMap.get(element
										.getAttribute("sourcePathKey"));

								FlowObject targetObject = (FlowObject) objectMap
										.get(element
												.getAttribute("destinationPathKey"));

								IElementType eType = StateflowElementTypes.EventConnection_3002;

								CreateRelationshipRequest req = new CreateRelationshipRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(), sourceObject,
										targetObject, eType);

								CreateElementCommand connectionCommand = new CreateElementCommand(
										req);

								ICommandProxy commandProxyConnection = new ICommandProxy(
										connectionCommand);

								stack.execute(commandProxyConnection);

								EventConnection connection = (EventConnection) connectionCommand
										.getNewElement();
								
								fillAttribute(connection,
										StateflowPackage.eINSTANCE
												.getEventConnection_SourceState(),
										sourceObject);

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getEventConnection_DestinationFlow(),
										targetObject);

								fillAttribute(connection,
										StateflowPackage.eINSTANCE
												.getEventConnection_EventID(),
										element.getAttribute("eventID"));

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getEventConnection_SourcePathKey(),
										sourceObject.getPathKey());

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getEventConnection_DestinationPathKey(),
										targetObject.getPathKey());

							} else if (node.getNodeName().equals("flowConnections")) {

								FlowObject sourceObject = (FlowObject) objectMap
										.get(element.getAttribute("sourcePathKey"));

								State targetObject = (State) objectMap.get(element
										.getAttribute("destinationPathKey"));

								IElementType eType = StateflowElementTypes.FlowObjectConnection_3001;

								CreateRelationshipRequest req = new CreateRelationshipRequest(
										mySelectedElement.getEditingDomain(),
										((DiagramImpl) mySelectedElement.getModel())
												.getElement(), sourceObject,
										targetObject, eType);

								CreateElementCommand connectionCommand = new CreateElementCommand(
										req);

								ICommandProxy commandProxyConnection = new ICommandProxy(
										connectionCommand);

								stack.execute(commandProxyConnection);

								FlowObjectConnection connection = (FlowObjectConnection) connectionCommand
										.getNewElement();

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getFlowObjectConnection_SourceFlow(),
										sourceObject);

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getFlowObjectConnection_DestinationState(),
										targetObject);

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getFlowObjectConnection_ExecutionFlowResultValue(),
										element
												.getAttribute("executionFlowResultValue"));

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getFlowObjectConnection_SourcePathKey(),
										sourceObject.getPathKey());

								fillAttribute(
										connection,
										StateflowPackage.eINSTANCE
												.getFlowObjectConnection_DestinationPathKey(),
										targetObject.getPathKey());

							}
						}
					}
				}

				mySelectedElement.deactivate();
				mySelectedElement.activate();
				mySelectedElement.refresh();

				ArrangeRequest arrangeRequest = new ArrangeRequest(
						ActionIds.ACTION_ARRANGE_ALL);

				List l = mySelectedElement.getChildren();

				arrangeRequest.setPartsToArrange(l);

				org.eclipse.gef.commands.Command arrangeCommand = mySelectedElement
						.getCommand(arrangeRequest);

				mySelectedElement.getDiagramEditDomain()
						.getDiagramCommandStack().execute(arrangeCommand);

			} else {
				// Exibe mensagem de erro 
				MessageDialog.openError(myShell, "Erro",
						"Arquivo para importação inválido!");
			}
		} catch (Throwable e) {
			e.printStackTrace();
			MessageDialog.openError(myShell, "Erro",
					e.getMessage());
		}
	}

	/**
	 * @generated NOT
	 * @param eObject
	 * @param eFeature
	 * @param value
	 */
	private void fillAttribute(EObject eObject, EStructuralFeature eFeature,
			Object value) {
		SetRequest setRequest = new SetRequest(mySelectedElement
				.getEditingDomain(), eObject, eFeature, value);

		SetValueCommand command = new SetValueCommand(setRequest);

		ICommandProxy commandValue = new ICommandProxy(command);

		mySelectedElement.getDiagramEditDomain().getDiagramCommandStack()
				.execute(commandValue);

	}

	/**
	 * @generated NOT
	 */
	public void run(IAction action) {
		LoadResourceDialog loadResourceDialog = new LoadResourceDialog(myShell,
				mySelectedElement.getEditingDomain());

		if (loadResourceDialog.open() != IDialogConstants.CANCEL_ID) {
			List uris = loadResourceDialog.getURIs();

			Iterator iter = uris.iterator();

			while (iter.hasNext()) {
				URI element = (URI) iter.next();

				try {
					processFile(element);
				} catch (ParserConfigurationException e) {
					e.printStackTrace();
				} catch (SAXException e) {
					e.printStackTrace();
				} catch (IOException e) {
					e.printStackTrace();
				}
			}
		}
	}

	/**
	 * @generated
	 */
	public void selectionChanged(IAction action, ISelection selection) {
		mySelectedElement = null;
		if (selection instanceof IStructuredSelection) {
			IStructuredSelection structuredSelection = (IStructuredSelection) selection;
			if (structuredSelection.size() == 1
					&& structuredSelection.getFirstElement() instanceof StateFlowEditPart) {
				mySelectedElement = (StateFlowEditPart) structuredSelection
						.getFirstElement();
			}
		}
		action.setEnabled(isEnabled());
	}

	/**
	 * @generated
	 */
	private boolean isEnabled() {
		return mySelectedElement != null;
	}
}
